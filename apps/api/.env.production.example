# =============================================================================
# ASSET FORGE API - Production Environment Configuration
# =============================================================================
# Copy this to Railway environment variables

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------

NODE_ENV=production
PORT=3004

# Frontend URL (for CORS) - Replace with your actual frontend domain
FRONTEND_URL=https://frontend-production-f53f.up.railway.app

# Allowed CORS Origins (comma-separated) - Include all frontend domains that need access
ALLOWED_ORIGINS=https://frontend-production-f53f.up.railway.app

# Image Server URL (for Meshy.ai to access concept art)
# Replace with your Railway domain
IMAGE_SERVER_URL=https://striking-forgiveness-production.up.railway.app

# -----------------------------------------------------------------------------
# DATABASE (Railway Auto-configured)
# -----------------------------------------------------------------------------

# Railway provides DATABASE_URL automatically when you add PostgreSQL
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Or use individual variables (Railway auto-injects these):
# DB_HOST=${{Postgres.HOST}}
# DB_PORT=${{Postgres.PORT}}
# DB_NAME=${{Postgres.DATABASE}}
# DB_USER=${{Postgres.USER}}
# DB_PASSWORD=${{Postgres.PASSWORD}}

# -----------------------------------------------------------------------------
# AI PROVIDERS (Required)
# -----------------------------------------------------------------------------

# OpenAI API Key
OPENAI_API_KEY=sk-proj-your-key-here

# Meshy AI API Key
MESHY_API_KEY=msy_your-key-here

# ElevenLabs API Key (for voice generation)
ELEVENLABS_API_KEY=your-key-here

# -----------------------------------------------------------------------------
# AI PROVIDERS (Optional)
# -----------------------------------------------------------------------------

# Vercel AI Gateway (Recommended for production)
AI_GATEWAY_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# AUTHENTICATION (Required for production)
# -----------------------------------------------------------------------------

# Privy Authentication
PRIVY_APP_ID=cmhbfhcm1003ml80cu47k4h2m
PRIVY_APP_SECRET=your-privy-app-secret

# -----------------------------------------------------------------------------
# STORAGE (Optional - for Cloudflare R2)
# -----------------------------------------------------------------------------

# Cloudflare R2 Configuration
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=asset-forge-assets
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# -----------------------------------------------------------------------------
# MESHY CONFIGURATION
# -----------------------------------------------------------------------------

MESHY_POLL_INTERVAL_MS=5000
MESHY_TIMEOUT_MS=300000
MESHY_TIMEOUT_STANDARD_MS=300000
MESHY_TIMEOUT_HIGH_MS=450000
MESHY_TIMEOUT_ULTRA_MS=600000
MESHY_MODEL_STANDARD=meshy-4
MESHY_MODEL_HIGH=meshy-5
MESHY_MODEL_ULTRA=meshy-5
MESHY_MODEL_DEFAULT=meshy-5

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------

ENABLE_GPT4_ENHANCEMENT=true
ENABLE_RETEXTURING=true
ENABLE_RIGGING=true

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------

DEBUG=false
LOG_LEVEL=info

# Optional: Add Sentry for error tracking
# SENTRY_DSN=

# -----------------------------------------------------------------------------
# SECURITY & RATE LIMITING
# -----------------------------------------------------------------------------

# Enable HTTPS enforcement in production
FORCE_HTTPS=true

# Rate limiting (optional)
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# RAILWAY DEPLOYMENT INSTRUCTIONS
# =============================================================================
#
# 1. Add PostgreSQL database in Railway dashboard
# 2. Copy all variables above to Railway → Variables tab
# 3. Replace placeholder values with actual credentials
# 4. Railway will automatically inject DATABASE_URL
# 5. Deploy via CLI: railway up
#    Or connect GitHub for auto-deploy on push
#
# =============================================================================
