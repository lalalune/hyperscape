# =============================================================================
# ASSET FORGE FRONTEND - Environment Configuration
# =============================================================================
#
# IMPORTANT: Vite requires environment variables to be prefixed with VITE_
# to expose them to the client-side code.
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Railway deployment, set these in the Railway dashboard.
#
# =============================================================================

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------

# API Server URL (Backend)
# Development: http://localhost:3004
# Production (Railway Internal): http://striking-forgiveness.railway.internal:3004
# Production (Public): https://striking-forgiveness-production.up.railway.app
# NOTE: Use internal Railway address for better performance and no egress fees
VITE_API_URL=http://localhost:3004

# CDN URL (for serving static assets)
# Development: http://localhost:3004
# Production (Railway Internal): http://striking-forgiveness.railway.internal:3004
VITE_CDN_URL=http://localhost:3004

# Image Server URL (for image generation)
# Development: http://localhost:8081
# Production (Railway Internal): http://striking-forgiveness.railway.internal:3004
VITE_IMAGE_SERVER_URL=http://localhost:8081

# Generation API URL (optional, for manifest service)
# Development: http://localhost:3004/api
# Production (Railway Internal): http://striking-forgiveness.railway.internal:3004/api
VITE_GENERATION_API_URL=http://localhost:3004/api

# Frontend URL (for callbacks and CORS)
# Development: http://localhost:3000
# Production: https://frontend-production-f53f.up.railway.app
VITE_FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# AUTHENTICATION (Privy)
# -----------------------------------------------------------------------------

# Privy App ID (REQUIRED)
# Get from: https://dashboard.privy.io
VITE_PUBLIC_PRIVY_APP_ID=cmhbfhcm1003ml80cu47k4h2m

# -----------------------------------------------------------------------------
# AI SERVICE CREDENTIALS (for direct client calls)
# -----------------------------------------------------------------------------

# OpenAI API Key
OPENAI_API_KEY=sk-proj-...

# Meshy AI API Key
MESHY_API_KEY=msy_...

# ElevenLabs API Key (for voice generation)
ELEVENLABS_API_KEY=sk_...

# Vercel AI Gateway API Key (recommended)
AI_GATEWAY_API_KEY=vck_...

# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-v1-...

# -----------------------------------------------------------------------------
# IMAGE GENERATION CONFIGURATION
# -----------------------------------------------------------------------------

# Image API Base URL
IMAGE_API_BASE_URL=https://api.openai.com/v1

# Image Model
IMAGE_MODEL=dall-e-3

# -----------------------------------------------------------------------------
# MESHY CONFIGURATION
# -----------------------------------------------------------------------------

# Meshy AI Model Selection
MESHY_MODEL_DEFAULT=meshy-5
MESHY_MODEL_STANDARD=meshy-5
MESHY_MODEL_HIGH=meshy-5
MESHY_MODEL_ULTRA=meshy-5

# Meshy Polling and Timeout Configuration
MESHY_POLL_INTERVAL_MS=5000
MESHY_TIMEOUT_MS=900000
MESHY_TIMEOUT_STANDARD_MS=600000
MESHY_TIMEOUT_HIGH_MS=1200000
MESHY_TIMEOUT_ULTRA_MS=1800000

# -----------------------------------------------------------------------------
# SECURITY & SESSION
# -----------------------------------------------------------------------------

# JWT Secret (for session management)
JWT_SECRET=your-secure-jwt-secret-here

# -----------------------------------------------------------------------------
# DEVELOPMENT & DEBUGGING
# -----------------------------------------------------------------------------

# Environment mode (automatically set by Vite)
# MODE=development  # or production

# Debug logging
# DEBUG=false
# LOG_LEVEL=info

# =============================================================================
# QUICK START
# =============================================================================
#
# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. Fill in required values:
#    - VITE_PUBLIC_PRIVY_APP_ID (required for authentication)
#    - VITE_API_URL (required for API calls)
#    - API keys for AI services you want to use
#
# 3. Start the development server:
#    npm run dev
#
# =============================================================================
# RAILWAY DEPLOYMENT
# =============================================================================
#
# For Railway deployment, set these environment variables in the Railway dashboard:
#
# Required (Build-time - must be set before deployment):
# - VITE_PUBLIC_PRIVY_APP_ID=cmhbfhcm1003ml80cu47k4h2m
# - VITE_API_URL=http://striking-forgiveness.railway.internal:3004
# - VITE_CDN_URL=http://striking-forgiveness.railway.internal:3004
# - VITE_GENERATION_API_URL=http://striking-forgiveness.railway.internal:3004/api
# - VITE_FRONTEND_URL=https://frontend-production-f53f.up.railway.app
#
# IMPORTANT: Use Railway internal addresses (*.railway.internal) for:
# - Faster performance (no external routing)
# - No egress fees
# - Better security
#
# Optional (if using client-side AI features):
# - OPENAI_API_KEY
# - MESHY_API_KEY
# - ELEVENLABS_API_KEY
# - AI_GATEWAY_API_KEY
#
# See RAILWAY_SETUP.md in project root for complete deployment guide
# =============================================================================
