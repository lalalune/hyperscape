# Hyperscape Coolify Environment Example
#
# Copy the relevant section from this file into each Coolify service's
# Environment Variables UI. Do not import this whole file into one service:
# some keys intentionally repeat because Hyperscape and Asset Forge are
# separate services with separate runtime environments.
# Do not commit a filled-in .env file. All values marked <...> are placeholders.
#
# Recommended Coolify services:
# - hyperscape: Docker Compose app using docker-compose.coolify.yml
# - postgres: included in docker-compose.coolify.yml
# - minio: included in docker-compose.coolify.yml
# - asset-forge: optional separate Coolify app using Dockerfile.coolify-asset-forge
#
# Domain examples used below:
# - APP_DOMAIN=https://play.example.com
# - ASSET_DOMAIN=https://assets.example.com
# - ASSET_FORGE_DOMAIN=https://assetforge.example.com

# =============================================================================
# HYPERSCAPE APP SERVICE
# =============================================================================

NODE_ENV=production
PORT=5555
USE_LOCAL_POSTGRES=false

# docker-compose.coolify.yml builds this from POSTGRES_* automatically:
# DATABASE_URL=postgresql://hyperscape:<POSTGRES_PASSWORD>@postgres:5432/hyperscape
POSTGRES_USER=hyperscape
POSTGRES_PASSWORD=<strong-postgres-password>
POSTGRES_DB=hyperscape

# Public runtime URLs. For a same-origin game deployment, these can be omitted
# and /env.js will infer them from the request host. Set them explicitly when
# using split domains, proxies, or a separate asset host.
PUBLIC_API_URL=https://play.example.com
PUBLIC_WS_URL=wss://play.example.com/ws
PUBLIC_CDN_URL=https://play.example.com/game-assets
PUBLIC_APP_URL=https://play.example.com

# Auth0 SPA config. These are public browser values, but should still be managed
# intentionally in Coolify so /env.js and the built client agree.
PUBLIC_AUTH0_DOMAIN=<your-auth0-tenant>.us.auth0.com
PUBLIC_AUTH0_CLIENT_ID=<your-auth0-spa-client-id>
# PUBLIC_AUTH0_AUDIENCE=https://api.example.com

# Server secrets. Generate JWT_SECRET with: openssl rand -base64 32
JWT_SECRET=<random-32-byte-secret>
ADMIN_CODE=<private-admin-code>

# Default production gameplay switches.
DEFAULT_GOBLINS_ENABLED=false
HOSTILE_MOBS_ENABLED=false
MOBS_ENABLED=false
ENABLE_MOBS=false

# In-game model agents. Keep providers pinned to Hyades when other provider keys
# are present but should not spawn runtime agents.
AUTO_START_AGENTS=false
SPAWN_MODEL_AGENTS=true
MODEL_AGENT_PROVIDERS=hyades
MAX_MODEL_AGENTS=1
HYADES_RUNTIME_URL=http://<hyades-host>
HYADES_LLM_ENDPOINT=http://<hyades-host>/v1
HYADES_LLM_MODEL=nemotron3-omni
HYADES_LLM_SMALL_MODEL=nemotron3-omni
HYADES_LLM_API_KEY=<hyades-api-key>

# Optional browser dashboard proxy for Hyades/Safier-style runtimes.
# If set on the server, the browser can use PUBLIC_AGENT_RUNTIME_URL=/api/agent-runtime.
# PUBLIC_AGENT_RUNTIME_URL=/api/agent-runtime
# SAFIER_RUNTIME_URL=http://<safier-host>

# =============================================================================
# MINIO SERVICE
# =============================================================================

# MinIO runs inside docker-compose.coolify.yml. The internal S3 endpoint used by
# other containers in the same Compose project is always:
#   http://minio:9000
#
# In Coolify, assign a public domain to the minio service on port 9000, e.g.:
#   https://assets.example.com -> minio:9000
#
# Optional admin console domain maps to port 9001, e.g.:
#   https://minio-console.example.com -> minio:9001
#
# Do not use the 9001 console URL as S3_PUBLIC_BASE_URL.
MINIO_ROOT_USER=hyperscape
MINIO_ROOT_PASSWORD=<strong-minio-password-at-least-8-chars>
S3_BUCKET_CONJURES=hyperscape-conjures

# =============================================================================
# ASSET FORGE SERVICE
# =============================================================================

# Set these on the optional Asset Forge Coolify app that uses
# Dockerfile.coolify-asset-forge. Asset Forge is the service that currently uses
# object storage for generated runtime GLBs and concept art.
NODE_ENV=production
ASSET_FORGE_API_PORT=3401
FRONTEND_URL=https://assetforge.example.com
IMAGE_SERVER_URL=https://assetforge.example.com
PUBLIC_URL=https://assetforge.example.com

# Share the Hyperscape Postgres database, or use a separate database if desired.
DATABASE_URL=postgresql://hyperscape:<POSTGRES_PASSWORD>@postgres:5432/hyperscape

# Object storage: returned asset URLs must use the browser-reachable public
# domain. If Asset Forge runs in the same Compose project/network as MinIO, use
# S3_ENDPOINT=http://minio:9000. If Asset Forge is a separate Coolify app, either
# attach it to the same Docker network or use the public MinIO API domain:
# S3_ENDPOINT=https://assets.example.com
OBJECT_STORAGE_ENABLED=true
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=hyperscape
S3_SECRET_ACCESS_KEY=<same-value-as-MINIO_ROOT_PASSWORD>
S3_BUCKET_CONJURES=hyperscape-conjures
S3_PUBLIC_BASE_URL=https://assets.example.com/hyperscape-conjures
CONJURE_STORAGE_PREFIX=conjures

# Preferred generation provider for production. Point this at the Hill/VRM
# bridge if you are using the DGX generation pipeline.
ASSET_FORGE_GENERATION_PROVIDER=hill_dgx
HILL_API_BASE_URL=https://vrmviewer.example.com
HILL_GENERATION_MODE=create
HILL_EXPORT_TARGET=library
HILL_API_POLL_INTERVAL_MS=3000
HILL_API_TIMEOUT_MS=1800000
# HILL_API_TOKEN=<optional-bridge-token>

# Local/remote prompt enhancement for Hill.
NEMOTRON_BASE_URL=http://<nemotron-host>:12345
NEMOTRON_MODEL=mlx-community/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-mxfp4
NEMOTRON_TEMPERATURE=0.2
NEMOTRON_MAX_TOKENS=450
# NEMOTRON_API_KEY=<optional-nemotron-key>

# Optional legacy/cloud generation providers. Leave unset unless that path is
# intentionally enabled.
# OPENAI_API_KEY=<openai-api-key>
# AI_GATEWAY_API_KEY=<vercel-ai-gateway-key>
# MESHY_API_KEY=<meshy-api-key>
# TRIPO_API_KEY=<tripo-api-key>
# ELEVENLABS_API_KEY=<elevenlabs-api-key>

# =============================================================================
# COMMON OPTIONAL PUBLIC CLIENT SETTINGS
# =============================================================================

# PUBLIC_STARTER_ITEMS=1
# PUBLIC_EMBED_ALLOWED_ORIGINS=https://partner.example.com
# PUBLIC_HYADES_URL=https://hyades.example.com
# PUBLIC_SAFIER_URL=https://safier.example.com
