# Asset Forge Environment Configuration
#
# ========================================
# SECURITY WARNING
# ========================================
# - NEVER commit this file to git
# - Generate secure random secrets for production
# - Use different values for dev/staging/production
#
# To generate secure secrets, run:
#   openssl rand -base64 32
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ========================================

# ========================================
# CRITICAL - REQUIRED FOR PRODUCTION
# ========================================

# Authentication (REQUIRED)
# Get from https://privy.io - Create an account and new app
PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# Security (REQUIRED IN ALL ENVIRONMENTS - NO DEFAULTS)
# These secrets are REQUIRED and will cause startup failure if missing
# Minimum length: 32 characters (base64 output is 43+ chars)
#
# Generate secure secrets:
#   JWT_SECRET:      openssl rand -base64 32
#   ENCRYPTION_KEY:  openssl rand -base64 32
#
# Example output: "a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0u1V2w3X4y5Z6"
JWT_SECRET=
ENCRYPTION_KEY=

# Blob Storage (REQUIRED if using blob storage)
# Get from Vercel Blob Storage dashboard
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here
USE_BLOB_STORAGE=true

# Cron Job Security (REQUIRED for scheduled cleanup jobs)
# Generate with: openssl rand -hex 32
CRON_SECRET=your_secure_random_cron_secret_here

# ========================================
# AI Services - Required for Asset Generation (SERVER-SIDE ONLY)
# ========================================
# SECURITY: These API keys are server-side only and should NEVER use VITE_ prefix
# All AI requests are proxied through the backend API

# AI Services - Required for 3D asset generation
MESHY_API_KEY=your_meshy_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Voice Generation - Optional (required only for voice features)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Alternative AI providers (choose one based on needs)
OPENROUTER_API_KEY=your_openrouter_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_GATEWAY_API_KEY=your_ai_gateway_key

# ========================================
# Frontend Environment Variables (VITE_ prefix required)
# ========================================
# SECURITY: Only non-sensitive configuration should use VITE_ prefix
# API keys must NEVER be exposed to the frontend

# Must match PRIVY_APP_ID above
VITE_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# API endpoints (use /api for same-domain)
VITE_API_URL=/api
VITE_GENERATION_API_URL=/api

# CDN URL for blob storage assets
VITE_CDN_URL=https://your-project.vercel-storage.com

# ========================================
# Storage & Database Configuration
# ========================================

# Database path (use /tmp for serverless environments like Vercel)
DATABASE_PATH=/tmp/asset-forge.db

# Migration Data Path - Path to blob migration tracking file
MIGRATION_LOG_PATH=/tmp/blob-assets.json

# ========================================
# AI Model Configuration
# ========================================

# Meshy 3D Model Settings
MESHY_MODEL_DEFAULT=meshy-5
MESHY_MODEL_HIGH=meshy-5
MESHY_MODEL_STANDARD=meshy-5
MESHY_MODEL_ULTRA=meshy-5
MESHY_POLL_INTERVAL_MS=5000
MESHY_TIMEOUT_MS=900000
MESHY_TIMEOUT_STANDARD_MS=600000
MESHY_TIMEOUT_HIGH_MS=1200000
MESHY_TIMEOUT_ULTRA_MS=1800000

# Image Generation Settings
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3

# ========================================
# Production Configuration
# ========================================

# Frontend URL (required for CORS in production)
FRONTEND_URL=https://your-domain.vercel.app

# Node environment
NODE_ENV=production

# Image server URL (for retexturing)
IMAGE_SERVER_URL=https://your-blob-cdn.vercel.app

# API server port (local development only)
API_PORT=3004

# ========================================
# Fly.io Deployment
# ========================================

# Fly.io App Name (used by deployment scripts)
FLY_APP_NAME=asset-forge

# Tigris S3 Storage (from: fly storage create)
AWS_ACCESS_KEY_ID=tid_your_access_key_here
AWS_SECRET_ACCESS_KEY=tsec_your_secret_key_here
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
BUCKET_NAME=your-bucket-name

# Redis URL (from: fly redis create)
REDIS_URL=redis://default:password@fly-redis-xxx.upstash.io

# PostgreSQL Database URL (set automatically by: fly postgres attach)
# DATABASE_URL=postgres://user:password@host:port/database

# ========================================
# Vercel Deployment (set by Vercel automatically)
# ========================================

# These are set automatically by Vercel
# VERCEL=1
# VERCEL_OIDC_TOKEN=...
