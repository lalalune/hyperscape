# Privy Authentication
# Get your App ID from https://dashboard.privy.io
# Make sure to whitelist your development and production URLs in the Privy dashboard:
# - Development: http://localhost:3000
# - Production: https://your-domain.vercel.app
VITE_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# API Configuration (optional, defaults to localhost:3004)
VITE_API_URL=http://localhost:3004
VITE_GENERATION_API_URL=http://localhost:3004/api

# Vercel Blob Storage (Production only - automatically configured on Vercel)
# Leave empty for local development (uses filesystem)
# Get this from: Vercel Dashboard → Storage → Blob → Environment Variables
HYPER_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# AI Service API Keys
OPENAI_API_KEY=sk-xxx
MESHY_API_KEY=msy_xxx
ELEVENLABS_API_KEY=sk_xxx

# Database (if using)
# DATABASE_URL=postgresql://...

# Server Configuration
API_PORT=3004
NODE_ENV=development
