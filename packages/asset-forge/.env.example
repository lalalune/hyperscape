# =============================================================================
# Asset Forge Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Privy Authentication
# -----------------------------------------------------------------------------
# Get your App ID from https://dashboard.privy.io
# Make sure to whitelist your development and production URLs in the Privy dashboard:
# - Development: http://localhost:3000
# - Production: https://your-domain.fly.dev
VITE_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# API URLs (defaults to localhost:3004 for development)
VITE_API_URL=http://localhost:3004
VITE_GENERATION_API_URL=http://localhost:3004/api

# Server Configuration
API_PORT=3004
NODE_ENV=development

# -----------------------------------------------------------------------------
# Tigris S3 Storage (Fly.io)
# -----------------------------------------------------------------------------
# Created with: fly storage create
# These are automatically set when you create a Tigris bucket on Fly.io
# For development: Leave empty to use local filesystem (gdd-assets/)
# For production: Set these from `fly storage create` output

AWS_ACCESS_KEY_ID=tid_xxx
AWS_SECRET_ACCESS_KEY=tsec_xxx
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
BUCKET_NAME=hyperscape-assets

# CDN URL (your existing CDN that pulls from Tigris as origin)
# For development: Leave empty to use Tigris direct URLs
# For production: Set to your CDN domain
PUBLIC_CDN_URL=https://your-cdn-domain.com

# -----------------------------------------------------------------------------
# Fly.io Postgres with pgvector
# -----------------------------------------------------------------------------
# Created with: fly postgres create
# Use pooled connection for most app queries (via PgBouncer)
# Use direct connection for migrations and admin tasks

# Pooled connection (recommended for app queries)
DATABASE_URL=postgresql://fly-user:password@pgbouncer.xxx.flympg.net/fly-db

# Direct connection (for migrations, vector operations)
DATABASE_URL_DIRECT=postgresql://fly-user:password@direct.xxx.flympg.net/fly-db

# -----------------------------------------------------------------------------
# Fly.io Redis (Upstash)
# -----------------------------------------------------------------------------
# Created with: fly redis create
# Used for caching, sessions, rate limiting, and job queues

REDIS_URL=redis://default:password@fly-redis-xxx.upstash.io

# -----------------------------------------------------------------------------
# AI Service API Keys
# -----------------------------------------------------------------------------
# OpenAI - For GPT-4 generation and embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-xxx

# Meshy.ai - For 3D model generation from images/text
MESHY_API_KEY=msy_xxx

# ElevenLabs - For voice generation
ELEVENLABS_API_KEY=sk_xxx

# -----------------------------------------------------------------------------
# Optional: Advanced Configuration
# -----------------------------------------------------------------------------
# Session Secret (generate with: openssl rand -base64 32)
# SESSION_SECRET=your-random-secret-here

# Rate Limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# Vector Search Configuration
# VECTOR_DIMENSIONS=1536
# VECTOR_INDEX_TYPE=hnsw
