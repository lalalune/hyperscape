{
  "name": "3d-asset-forge",
  "version": "1.0.0",
  "description": "AI-powered 3D asset generation system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:frontend\" \"bun run dev:backend\"",
    "dev:frontend": "bun --bun vite",
    "dev:backend": "concurrently \"bun run dev:api\" \"bun run dev:images\"",
    "dev:api": "bun run server/api.mjs",
    "dev:images": "bun run scripts/start-image-server.mjs",
    "db:test": "bun run scripts/test-neon-connection.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "build": "bun run clean && bun run scripts/build-frontend.mjs",
    "start": "bun run start:production",
    "start:production": "bun run server/api.mjs",
    "start:backend": "concurrently \"bun run start:api\" \"bun run start:image-server\"",
    "start:api": "bun run server/api.mjs",
    "start:image-server": "bun run scripts/start-image-server.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts,.tsx",
    "preview": "bun --bun vite preview",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit server/services/__tests__ src/services/__tests__",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:voice-standalone": "playwright test voice-standalone",
    "test:voice-manifest": "playwright test voice-manifest",
    "test:voice-integration": "playwright test voice-integration",
    "test:voice-visual": "playwright test voice-visual",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:integration": "NODE_ENV=test playwright test tests/integration",
    "test:integration:watch": "NODE_ENV=test playwright test tests/integration --watch",
    "test:integration:coverage": "NODE_ENV=test playwright test tests/integration --coverage",
    "test:integration:auth": "NODE_ENV=test playwright test tests/integration/routes/auth.test.mjs",
    "test:integration:admin": "NODE_ENV=test playwright test tests/integration/routes/admin.test.mjs",
    "assets:audit": "bun run scripts/audit-assets.ts",
    "assets:normalize": "bun run scripts/normalize-all-assets.ts",
    "blob:migrate": "bun run scripts/migrate-to-blob.mjs",
    "blob:migrate:dry-run": "bun run scripts/migrate-to-blob.mjs --dry-run",
    "blob:rollback": "bun run scripts/rollback-from-blob.mjs",
    "blob:list": "bun run scripts/list-blobs.mjs",
    "blob:delete": "bun run scripts/delete-all-blobs.mjs",
    "blob:cleanup": "bun run scripts/cleanup-blobs.mjs",
    "blob:cleanup:dry-run": "bun run scripts/cleanup-blobs.mjs --dry-run",
    "blob:cleanup:execute": "bun run scripts/cleanup-blobs.mjs --execute",
    "check:deps": "bun x depcheck",
    "check:all": "bun x knip",
    "count:lines": "bun run scripts/count-lines.mjs",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "ai",
    "3d",
    "generation",
    "meshy",
    "gpt-4",
    "rpg",
    "game-assets"
  ],
  "author": "Lucid",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.35",
    "@ai-sdk/openai": "^2.0.53",
    "@aws-sdk/client-s3": "^3.917.0",
    "@elevenlabs/elevenlabs-js": "^2.20.1",
    "@mediapipe/hands": "^0.4.1675469240",
    "@neondatabase/serverless": "^1.0.2",
    "@privy-io/react-auth": "^3.3.0",
    "@privy-io/server-auth": "^1.14.0",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.0.0",
    "@sentry/node": "^10.22.0",
    "@sentry/react": "^10.22.0",
    "@tensorflow-models/hand-pose-detection": "^2.0.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/blob": "^2.0.0",
    "@vercel/speed-insights": "^1.2.0",
    "ai": "^5.0.76",
    "better-sqlite3": "^11.9.0",
    "buffer": "^6.0.3",
    "chalk": "^4.1.2",
    "clsx": "^2.0.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.36.4",
    "elevenlabs": "^0.8.2",
    "eventemitter3": "^5.0.1",
    "express": "^4.18.2",
    "express-jwt": "^8.4.1",
    "express-rate-limit": "^8.1.0",
    "fuse.js": "^7.1.0",
    "immer": "^10.1.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.525.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^5.9.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.178.0",
    "three-mesh-bvh": "^0.9.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.19.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@types/three": "^0.178.1",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.0.2",
    "autoprefixer": "^10.4.16",
    "depcheck": "^1.4.7",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.33.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.0.0",
    "happy-dom": "^20.0.8",
    "knip": "^5.62.0",
    "postcss": "^8.4.32",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.3.6",
    "terser": "^5.44.0",
    "typescript": "^5.3.3",
    "vite": "^6.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.0.2",
    "@types/bun": "latest"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}
