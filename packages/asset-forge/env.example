# AI Creation System Environment Variables
# Copy this file to .env and add your actual API keys

# Client-side environment variables (must be prefixed with VITE_)
VITE_OPENAI_API_KEY=your-openai-api-key-here
VITE_MESHY_API_KEY=your-meshy-api-key-here
VITE_CDN_URL=http://localhost:8080
VITE_GENERATION_API_URL=http://localhost:3004/api
VITE_PIPELINE_POLL_INTERVAL_MS=1500
VITE_DEBUG_PIPELINE=false

# Backend API Keys (for server-side operations)
# Note: If running server-side code, you may also need these without VITE_ prefix
OPENAI_API_KEY=your-openai-api-key-here
MESHY_API_KEY=your-meshy-api-key-here

# Image Generation API Configuration
# Supports OpenAI, OpenRouter, and other OpenAI-compatible providers
# Model name (default: dall-e-3)
# For OpenRouter: use format like "openai/gpt-5-image-mini" or "openai/dall-e-3"
# For OpenAI directly: use "dall-e-2", "dall-e-3", or newer models
IMAGE_MODEL=dall-e-3

# Base URL for image generation API (default: https://api.openai.com/v1)
# For OpenRouter: https://openrouter.ai/api/v1
# For OpenAI: https://api.openai.com/v1
IMAGE_API_BASE_URL=https://api.openai.com/v1

# Optional headers for OpenRouter (for rankings on openrouter.ai)
# IMAGE_API_REFERER=https://your-site-url.com
# IMAGE_API_TITLE=Your Site Name

# Meshy polling configuration (server-side)
# Polling interval in milliseconds (default 5000)
MESHY_POLL_INTERVAL_MS=5000
# Overall default timeout in milliseconds (default 300000 = 5 minutes)
MESHY_TIMEOUT_MS=900000

# Optional per-quality timeouts (override default) in milliseconds
# Examples suitable for longer-running tasks
MESHY_TIMEOUT_STANDARD_MS=600000
MESHY_TIMEOUT_HIGH_MS=1200000
MESHY_TIMEOUT_ULTRA_MS=1800000

# Optional Meshy model selection
# Default if no per-quality model provided
MESHY_MODEL_DEFAULT=meshy-5
# Per-quality model overrides (optional)
MESHY_MODEL_STANDARD=meshy-5
MESHY_MODEL_HIGH=meshy-5
MESHY_MODEL_ULTRA=meshy-5

# Server Ports (avoiding conflicts with Hyperscape)
# API Server (default: 3004, Hyperscape uses 3001)
API_PORT=3004
# CDN Server (Hyperscape CDN runs on 8080, serves assets)
CDN_URL=http://localhost:8080
# Image Server URL for Meshy (needs to be publicly accessible)
# Use the CDN URL for local development, or a public URL for production
IMAGE_SERVER_URL=http://localhost:8080

# ============================================
# Example Configurations for Different Providers
# ============================================

# Example 1: OpenRouter with GPT-5 Image Mini
# OPENAI_API_KEY=your-openrouter-api-key
# IMAGE_MODEL=openai/gpt-5-image-mini
# IMAGE_API_BASE_URL=https://openrouter.ai/api/v1
# IMAGE_API_REFERER=https://your-site.com
# IMAGE_API_TITLE=Asset Forge

# Example 2: OpenRouter with DALL-E 3
# OPENAI_API_KEY=your-openrouter-api-key
# IMAGE_MODEL=openai/dall-e-3
# IMAGE_API_BASE_URL=https://openrouter.ai/api/v1
# IMAGE_API_REFERER=https://your-site.com
# IMAGE_API_TITLE=Asset Forge

# Example 3: OpenAI Direct
# OPENAI_API_KEY=your-openai-api-key
# IMAGE_MODEL=dall-e-3
# IMAGE_API_BASE_URL=https://api.openai.com/v1