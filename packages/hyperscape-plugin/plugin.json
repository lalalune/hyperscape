{
  "id": "com.hyperforge.hyperscape",
  "name": "Hyperia",
  "version": "0.1.0",
  "description": "Meta-plugin for the Hyperia game. Composes the constituent gameplay plugins into a single 'all of Hyperia' loadable. Hosts that want full Hyperia load this; hosts that want a subset load the constituent plugins directly.",
  "entry": "./dist/index.js",
  "author": {
    "name": "Hyperforge"
  },
  "license": "GPL-3.0",
  "hyperforgeApi": "0.1.0",
  "dependencies": [
    {
      "id": "com.hyperforge.combat",
      "versionRange": "^0.1.0"
    },
    {
      "id": "com.hyperforge.skills",
      "versionRange": "^0.1.0"
    }
  ],
  "loadAfter": ["com.hyperforge.combat", "com.hyperforge.skills"],
  "enabledByDefault": false,
  "contributions": {
    "systems": [],
    "entities": [],
    "widgets": [
      "com.hyperforge.hyperscape.action-progress-bar",
      "com.hyperforge.hyperscape.alignment-guides",
      "com.hyperforge.hyperscape.array-input",
      "com.hyperforge.hyperscape.avatar",
      "com.hyperforge.hyperscape.badge",
      "com.hyperforge.hyperscape.breadcrumbs",
      "com.hyperforge.hyperscape.buff-bar",
      "com.hyperforge.hyperscape.checkbox",
      "com.hyperforge.hyperscape.chip-list",
      "com.hyperforge.hyperscape.code-block",
      "com.hyperforge.hyperscape.coin-pouch",
      "com.hyperforge.hyperscape.confirm-dialog",
      "com.hyperforge.hyperscape.connection-indicator",
      "com.hyperforge.hyperscape.context-menu",
      "com.hyperforge.hyperscape.countdown-display",
      "com.hyperforge.hyperscape.cursor-tooltip",
      "com.hyperforge.hyperscape.curve-preview",
      "com.hyperforge.hyperscape.death-screen",
      "com.hyperforge.hyperscape.dialogue-panel",
      "com.hyperforge.hyperscape.disconnected-overlay",
      "com.hyperforge.hyperscape.divider",
      "com.hyperforge.hyperscape.drag-ghost-overlay",
      "com.hyperforge.hyperscape.empty-state",
      "com.hyperforge.hyperscape.equipment-slot-icon",
      "com.hyperforge.hyperscape.floating-xp-drops",
      "com.hyperforge.hyperscape.home-teleport-button",
      "com.hyperforge.hyperscape.icon-button",
      "com.hyperforge.hyperscape.incoming-request-modal",
      "com.hyperforge.hyperscape.key-value-list",
      "com.hyperforge.hyperscape.keyboard-shortcut-hint",
      "com.hyperforge.hyperscape.kicked-overlay",
      "com.hyperforge.hyperscape.level-up-toast",
      "com.hyperforge.hyperscape.loading-spinner",
      "com.hyperforge.hyperscape.minimap-compass",
      "com.hyperforge.hyperscape.minimap-home-teleport-orb",
      "com.hyperforge.hyperscape.minimap-stamina-orb",
      "com.hyperforge.hyperscape.notification-toast-list",
      "com.hyperforge.hyperscape.pagination",
      "com.hyperforge.hyperscape.progress-bar",
      "com.hyperforge.hyperscape.quantity-prompt",
      "com.hyperforge.hyperscape.range-slider",
      "com.hyperforge.hyperscape.section-header",
      "com.hyperforge.hyperscape.segmented-control",
      "com.hyperforge.hyperscape.select-option",
      "com.hyperforge.hyperscape.skeleton",
      "com.hyperforge.hyperscape.skill-select-modal",
      "com.hyperforge.hyperscape.step-indicator",
      "com.hyperforge.hyperscape.text-input",
      "com.hyperforge.hyperscape.toggle-switch",
      "com.hyperforge.hyperscape.unlocks-section",
      "com.hyperforge.hyperscape.victory-overlay",
      "com.hyperforge.hyperscape.xp-orb"
    ],
    "manifestSchemas": [],
    "paletteCategories": [],
    "toolbarTools": [],
    "commands": [],
    "entityTypes": [
      {
        "kind": "npc",
        "type": "shopkeeper",
        "description": "Opens a store UI on click. Reads `storeId` to look up the store catalog.",
        "requiredFields": ["storeId"],
        "acceptedAssetTypes": ["character"]
      },
      {
        "kind": "npc",
        "type": "questgiver",
        "description": "Offers quests on dialogue. Quest mappings are authored separately via PROPOSE_QUEST.",
        "requiredFields": [],
        "acceptedAssetTypes": ["character"]
      },
      {
        "kind": "npc",
        "type": "banker",
        "description": "Opens the bank UI on click. Stores items per-account.",
        "requiredFields": [],
        "acceptedAssetTypes": ["character"]
      },
      {
        "kind": "npc",
        "type": "guard",
        "description": "Neutral or hostile patrolling NPC. Does not interact unless attacked.",
        "requiredFields": [],
        "acceptedAssetTypes": ["character"]
      },
      {
        "kind": "npc",
        "type": "trainer",
        "description": "Skill trainer dialogue NPC — speaks about a specific skill.",
        "requiredFields": [],
        "acceptedAssetTypes": ["character"]
      },
      {
        "kind": "mobSpawn",
        "type": "mob",
        "description": "Generic combat creature spawn. Engaged by player attacks; respawns on the manifest's `respawnTicks` cadence.",
        "requiredFields": [],
        "acceptedAssetTypes": ["creature"]
      },
      {
        "kind": "mobSpawn",
        "type": "aggressive",
        "description": "Hostile mob that attacks the player on sight within aggro range.",
        "requiredFields": [],
        "acceptedAssetTypes": ["creature"]
      },
      {
        "kind": "mobSpawn",
        "type": "passive",
        "description": "Mob that only retaliates if attacked first. Useful for ambient flavor.",
        "requiredFields": [],
        "acceptedAssetTypes": ["creature"]
      },
      {
        "kind": "resource",
        "type": "tree",
        "description": "Woodcutting target. Yields logs based on the woodcutting skill manifest.",
        "requiredFields": [],
        "acceptedAssetTypes": ["prop"]
      },
      {
        "kind": "resource",
        "type": "rock",
        "description": "Mining target. Yields ores based on the mining skill manifest.",
        "requiredFields": [],
        "acceptedAssetTypes": ["prop"]
      },
      {
        "kind": "resource",
        "type": "fishing_spot",
        "description": "Fishing target. Yields fish based on the fishing skill manifest.",
        "requiredFields": [],
        "acceptedAssetTypes": ["prop"]
      },
      {
        "kind": "station",
        "type": "anvil",
        "description": "Smithing station. Player uses metal bars + a hammer to forge weapons/armor.",
        "requiredFields": [],
        "acceptedAssetTypes": ["prop"]
      },
      {
        "kind": "station",
        "type": "furnace",
        "description": "Smelting station. Converts ore + coal into metal bars.",
        "requiredFields": [],
        "acceptedAssetTypes": ["prop"]
      },
      {
        "kind": "station",
        "type": "range",
        "description": "Cooking station. Converts raw food into edible food (heals when consumed).",
        "requiredFields": [],
        "acceptedAssetTypes": ["prop"]
      },
      {
        "kind": "station",
        "type": "bank",
        "description": "Banking deposit/withdraw station. Same UI as the banker NPC but a static prop.",
        "requiredFields": [],
        "acceptedAssetTypes": ["prop"]
      }
    ]
  },
  "tags": ["meta", "hyperia", "game"]
}
