{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for Hyperia",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-title",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-center",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-cursor-visible",
    "core:window:allow-set-cursor-grab",
    "core:webview:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:image:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "deep-link:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*.hyperia.club/*"
        },
        {
          "url": "https://hyperia-production.up.railway.app/*"
        },
        {
          "url": "wss://hyperia-production.up.railway.app/*"
        },
        {
          "url": "https://*.up.railway.app/*"
        },
        {
          "url": "wss://*.up.railway.app/*"
        },
        {
          "url": "https://*.privy.io/*"
        },
        {
          "url": "https://auth.privy.io/*"
        }
      ]
    },
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-open-path",
    "os:default",
    "os:allow-platform",
    "os:allow-arch",
    "os:allow-version",
    "os:allow-os-type",
    "process:default",
    "process:allow-exit",
    "process:allow-restart",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
