# Required: API key. Use whatever key matches ANTHROPIC_BASE_URL —
# Anthropic key when hitting Anthropic, OpenRouter key when hitting
# OpenRouter, etc. Never commit a real value.
ANTHROPIC_API_KEY=sk-ant-api03-PLACEHOLDER

# Optional: override the LLM API base URL. Lets you use cheaper
# providers without code changes. Examples:
#
#   # OpenRouter (cheap; supports Gemini Flash, Llama 3.3, DeepSeek,
#   # Anthropic, etc. via Anthropic-compatible endpoint):
#   ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1/anthropic
#   ANTHROPIC_API_KEY=sk-or-v1-...
#   AGENT_SERVER_MODEL=google/gemini-2.0-flash-001
#
# Common cheap models (input / output per million tokens):
#   anthropic/claude-haiku-4-5             $1.00 / $5.00
#   anthropic/claude-sonnet-4-5            $3.00 / $15.00 (default)
#   google/gemini-2.0-flash-001            $0.075 / $0.30  ← cheapest reliable
#   deepseek/deepseek-chat                 $0.27 / $1.10
#   meta-llama/llama-3.3-70b-instruct:free $0.00 / $0.00 (rate-limited)
#
# Leave unset to hit Anthropic directly with the official SDK.
# ANTHROPIC_BASE_URL=

# Optional: server port. Default 5180.
# AGENT_SERVER_PORT=5180

# Optional: bind hostname. Default 0.0.0.0.
# AGENT_SERVER_HOSTNAME=0.0.0.0

# Optional: default model. Default claude-sonnet-4-5. When pointing
# ANTHROPIC_BASE_URL at OpenRouter, use the `provider/model` form
# (e.g. `anthropic/claude-haiku-4-5`, `google/gemini-2.0-flash-001`).
# AGENT_SERVER_MODEL=claude-sonnet-4-5

# Optional: catalog.json path override.
# HYPERFORGE_CATALOG_PATH=packages/widget-catalog/dist/catalog.json
