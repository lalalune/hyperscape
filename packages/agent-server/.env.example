# Required: API key. Use whatever key matches ANTHROPIC_BASE_URL —
# Anthropic key when hitting Anthropic, OpenRouter key when hitting
# OpenRouter, etc. Never commit a real value.
ANTHROPIC_API_KEY=sk-ant-api03-PLACEHOLDER

# Optional: override the LLM API base URL. Lets you use cheaper
# providers without code changes. The agent-runner expects Anthropic
# Messages-API response shape (`{ content: [...] }`) — so the
# provider must speak Anthropic-compat, not just be reachable.
#
# RELIABLE: Anthropic models via OpenRouter's Anthropic-compat
# endpoint. Cheaper than direct Anthropic for Haiku, identical
# tool-calling behavior (same model, same wire protocol):
#
#   ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1/anthropic
#   ANTHROPIC_API_KEY=sk-or-v1-...
#   AGENT_SERVER_MODEL=anthropic/claude-haiku-4-5   ← recommended for testing
#
# Pricing (input / output per million tokens):
#   anthropic/claude-haiku-4-5             $1.00 / $5.00   ← 3× cheaper than Sonnet
#   anthropic/claude-sonnet-4-5            $3.00 / $15.00  (default model)
#
# EXPERIMENTAL: non-Anthropic models via OpenRouter's Anthropic-compat
# shim. Cheaper but tool-calling reliability varies — the shim
# translates each call, and not every model preserves tool_use blocks
# correctly. Try at your own risk:
#
#   AGENT_SERVER_MODEL=google/gemini-2.0-flash-001    $0.08 / $0.30
#   AGENT_SERVER_MODEL=deepseek/deepseek-chat         $0.27 / $1.10
#   AGENT_SERVER_MODEL=meta-llama/llama-3.3-70b-instruct:free  free, rate-limited
#
# If you see "LLM returned a malformed response (no `content` array)"
# in the chat after switching, the model+shim combo isn't working —
# fall back to anthropic/claude-haiku-4-5.
#
# Leave unset to hit Anthropic directly with the official SDK.
# ANTHROPIC_BASE_URL=

# Optional: server port. Default 5180.
# AGENT_SERVER_PORT=5180

# Optional: bind hostname. Default 0.0.0.0.
# AGENT_SERVER_HOSTNAME=0.0.0.0

# Optional: default model. Default claude-sonnet-4-5. When pointing
# ANTHROPIC_BASE_URL at OpenRouter, use the `provider/model` form
# (e.g. `anthropic/claude-haiku-4-5`, `google/gemini-2.0-flash-001`).
# AGENT_SERVER_MODEL=claude-sonnet-4-5

# Optional: catalog.json path override.
# HYPERFORGE_CATALOG_PATH=packages/widget-catalog/dist/catalog.json
