# Workspace configuration
workspaces-update=false
save-exact=false
package-lock=true

# Performance optimizations
fund=false
audit=false

# Engine strict to ensure Node.js version compatibility
engine-strict=true

# Use npm registry
registry=https://registry.npmjs.org/

# Handle peer dependency conflicts more gracefully
legacy-peer-deps=true

@playhyperia:registry=https://npm.pkg.github.com
