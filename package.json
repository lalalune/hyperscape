{
  "name": "@hyperforge/hyperia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hyperia - AI-powered virtual world with RPG elements",
  "keywords": [
    "hyperia",
    "virtual-worlds",
    "rpg",
    "3d",
    "metaverse"
  ],
  "author": "Hyperia Team",
  "license": "MIT",
  "engines": {
    "node": "22.23.2",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/node-runtime-policy.mjs",
    "install": "node scripts/install.mjs",
    "postinstall": "node scripts/ensure-assets.mjs",
    "assets:sync": "cd packages/server/world/assets && git pull origin main",
    "assets:validate": "node scripts/validate-assets-sync.mjs",
    "assets:validate:duel-launch": "node scripts/validate-duel-launch-assets.mjs",
    "assets:verify:duel-arena-layout": "bun scripts/verify-duel-arena-manifest.ts",
    "assets:verify:preparation-topology": "bun scripts/verify-preparation-topology.ts",
    "assets:verify:town-collision": "bun scripts/verify-town-collision.ts",
    "branding:check:legacy": "node scripts/check-legacy-branding.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:optimize:dry": "node scripts/optimize-assets.mjs --dry-run --verbose",
    "assets:optimize:textures": "node scripts/optimize-assets.mjs --textures",
    "assets:optimize:models": "node scripts/optimize-assets.mjs --models",
    "models:audit": "node scripts/audit-models.mjs",
    "models:audit:verbose": "node scripts/audit-models.mjs --verbose",
    "avatars:audit:launch": "node scripts/audit-avatar-lods.mjs",
    "avatars:candidates:build": "node scripts/build-duel-avatar-candidates.mjs",
    "avatars:candidates:capture": "node scripts/capture-duel-avatar-candidates.mjs",
    "avatars:candidates:check": "node scripts/build-duel-avatar-candidates.mjs --check",
    "avatars:candidates:test": "node --test scripts/build-duel-avatar-candidates.test.mjs",
    "avatars:motion:capture": "node scripts/capture-duel-avatar-motion.mjs",
    "equipment:certify:bronze-2h": "node scripts/certify-rigid-duel-equipment.mjs --input packages/server/world/assets/models/swords/2h-swords/2h-sword-bronze-aligned.glb --item-id bronze_2h_sword --avatar-id steve --legacy-avatar-id /api/assets/steve/model --slot weapon --write",
    "equipment:certify:bronze-2h:check": "node scripts/certify-rigid-duel-equipment.mjs --input packages/server/world/assets/models/swords/2h-swords/2h-sword-bronze-aligned.glb --item-id bronze_2h_sword --avatar-id steve --legacy-avatar-id /api/assets/steve/model --slot weapon --check",
    "equipment:certifications:check": "node scripts/verify-duel-rigid-equipment-certifications.mjs",
    "equipment:certifications:test": "node --test scripts/certify-rigid-duel-equipment.test.mjs scripts/verify-duel-rigid-equipment-certifications.test.mjs",
    "equipment:steve-fits:build": "node scripts/build-steve-rigid-duel-equipment.mjs --write",
    "equipment:steve-fits:check": "node scripts/build-steve-rigid-duel-equipment.mjs --check",
    "equipment:steve-fits:test": "node --test scripts/build-steve-rigid-duel-equipment.test.mjs",
    "equipment:fit:audit": "node scripts/audit-duel-equipment-fit.mjs",
    "equipment:fit:test": "node --test scripts/audit-duel-equipment-fit.test.mjs",
    "avatars:sources:audit": "node scripts/inventory-duel-avatar-sources.mjs",
    "avatars:sources:check": "node scripts/inventory-duel-avatar-sources.mjs --check",
    "avatars:sources:capture": "node scripts/capture-duel-avatar-candidates.mjs --manifest artifacts/duel-avatar-candidates/source-inventory.json --output artifacts/duel-avatar-candidates/source-contact-sheet.png",
    "avatars:sources:test": "node --test scripts/inventory-duel-avatar-sources.test.mjs",
    "avatars:optimize:test": "node --test scripts/optimize-vrm-lod.test.mjs",
    "models:optimize": "node scripts/optimize-models-full.mjs --backup",
    "models:optimize:dry": "node scripts/optimize-models-full.mjs --dry-run --verbose",
    "avatars:optimize": "blender --background --python scripts/optimize-avatars.py",
    "icons:slice": "bun scripts/slice-spritesheet.ts",
    "icons:slice-batch": "bun scripts/slice-generation-icons-batch.ts",
    "assets:atlas": "node scripts/atlas-materials.mjs",
    "assets:atlas:all": "node scripts/atlas-materials.mjs --dir assets --recursive",
    "build": "turbo run build --filter=!@hyperforge/app",
    "build:shared": "cd packages/shared && bun run build",
    "build:client": "cd packages/client && bun run build",
    "build:server": "cd packages/server && bun run build",
    "build:all": "bun run build",
    "predev": "bun scripts/dev-setup.mjs",
    "dev": "turbo run dev --filter=@hyperforge/shared --filter=@hyperforge/server --filter=@hyperforge/client",
    "dev:with-forge": "turbo run dev --filter=@hyperforge/shared --filter=@hyperforge/server --filter=@hyperforge/client --filter=@hyperforge/asset-forge",
    "dev:no-server": "turbo run dev --filter=@hyperforge/shared --filter=@hyperforge/client",
    "dev:app": "turbo run dev --filter=@hyperforge/app",
    "dev:all": "concurrently \"bun run dev:ai\" \"bun run dev:forge\"",
    "dev:shared": "cd packages/shared && bun run dev",
    "dev:client": "cd packages/client && bun run dev",
    "dev:server": "cd packages/server && bun run dev",
    "dev:reset": "bun run clean && rm -rf packages/*/node_modules/.vite && bun run build:shared && bun run dev",
    "dev:memcheck": "bun scripts/dev-memory-leak-check.mjs",
    "dev:memcheck:duel": "bun scripts/dev-memory-leak-check.mjs --duration-s=900 -- bun run dev:duel",
    "dev:forge": "bun run --cwd packages/asset-forge dev",
    "dev:ai": "concurrently -n game,elizaos -c blue,magenta \"STREAMING_ANNOUNCEMENT_MS=30000 STREAMING_FIGHTING_MS=150000 STREAMING_END_WARNING_MS=10000 STREAMING_RESOLUTION_MS=10000 bun run dev\" \"cd packages/plugin-hyperia && if [ -n \\\"$HYPERIA_AUTH_TOKEN\\\" ] && [ -n \\\"$HYPERIA_CHARACTER_ID\\\" ]; then PORT=4001 elizaos start; else echo '[dev:ai] Skipping external elizaos agent (set HYPERIA_AUTH_TOKEN and HYPERIA_CHARACTER_ID to enable)'; fi\"",
    "cdn:up": "bun scripts/cdn.mjs",
    "cdn:watch": "bun scripts/cdn.mjs --watch",
    "cdn:restart": "bun scripts/cdn.mjs --force",
    "cdn:down": "cd packages/server && docker-compose down cdn",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs --all",
    "deploy:cloudflare:assets": "node scripts/deploy-cloudflare.mjs --assets",
    "deploy:cloudflare:frontend": "node scripts/deploy-cloudflare.mjs --frontend",
    "deploy:cloudflare:prod": "node scripts/deploy-cloudflare.mjs --all --production",
    "sync:r2": "node scripts/sync-r2-assets.mjs",
    "sync:r2:dry": "node scripts/sync-r2-assets.mjs --dry-run",
    "sync:r2:verbose": "node scripts/sync-r2-assets.mjs --verbose",
    "start": "cd packages/server && bun run start",
    "start:web3": "MODE=web3 CHAIN=base-sepolia cd packages/server && bun run start",
    "start:web3:mainnet": "MODE=web3 MAINNET=true cd packages/server && bun run start",
    "dev:web3": "bash scripts/dev-web3.sh",
    "contracts:build": "cd packages/contracts && mud build",
    "contracts:deploy:local": "cd packages/contracts && mud deploy",
    "contracts:deploy:testnet": "cd packages/contracts && mud deploy --profile base-sepolia",
    "contracts:deploy:mainnet": "cd packages/contracts && mud deploy --profile base-mainnet",
    "contracts:test": "cd packages/contracts && mud test",
    "web3:seed:items": "cd packages/web3 && bun src/mapping/seed-items.ts",
    "web3:seed:shops": "cd packages/web3 && bun src/mapping/seed-shops.ts",
    "web3:test:onchain": "cd packages/web3 && bun src/testing/onchain-smoke.ts",
    "web3:test:e2e": "cd packages/web3 && bun src/testing/onchain-e2e.ts",
    "web3:test:full": "bash scripts/test-web3-local.sh",
    "duel-oracle:build": "turbo run build --filter=@playhyperia/duel-oracle-solana",
    "duel-oracle:pack": "bunx npm pack ./packages/duel-oracle-solana",
    "test:gameplay:matrix": "bash scripts/test-gameplay-matrix.sh",
    "web3:debug": "cd packages/web3 && bun src/debug/debug-tools.ts",
    "web3:debug:chain": "bun run web3:debug -- chain",
    "web3:debug:player": "bun run web3:debug -- player",
    "web3:debug:item": "bun run web3:debug -- item",
    "web3:debug:trade": "bun run web3:debug -- trade",
    "web3:debug:stats": "bun run web3:debug -- stats",
    "test": "bun run --cwd packages/impostors build && turbo run test --filter=!@hyperforge/app --filter=!@playhyperia/duel-oracle-evm",
    "loadtest": "bun scripts/loadtest.mjs",
    "loadtest:ccu": "bun scripts/loadtest.mjs --ccu-test",
    "loadtest:rendering": "bun scripts/loadtest.mjs --rendering-test",
    "loadtest:skip-dev": "bun scripts/loadtest.mjs --skip-dev",
    "loadtest:streaming": "bun scripts/load-test-streaming.mjs",
    "loadtest:streaming:burst": "bun scripts/load-test-streaming-burst.mjs",
    "stream:layout:verify": "bun scripts/verify-streaming-overlay-layout.mjs",
    "duel:capture:scenarios": "bun scripts/capture-duel-arena-scenarios.mjs",
    "duel:capture:motion": "bun scripts/capture-duel-motion-telemetry.mjs",
    "dev:duel": "bun scripts/dev-duel.mjs",
    "dev:duel:skip-dev": "bun scripts/dev-duel.mjs --skip-dev",
    "duel": "bun scripts/duel-stack.mjs",
    "duel:full": "bun scripts/duel-stack.mjs --with-mm",
    "duel:prod": "npx pm2 start ecosystem.config.cjs",
    "duel:prod:stop": "npx pm2 stop ecosystem.config.cjs",
    "duel:prod:restart": "npx pm2 restart ecosystem.config.cjs",
    "duel:prod:logs": "npx pm2 logs hyperia-duel",
    "duel:prod:status": "npx pm2 status",
    "duel:verify": "bun scripts/verify-duel-stack.mjs",
    "duel:smoke:clean": "node scripts/smoke-duel-launch.mjs",
    "duel:test:hyperbet-backend": "bun scripts/test-duel-stack-hyperbet-backend.mjs",
    "duel:scope:sol": "node scripts/check-sol-only-duel-scope.mjs",
    "duel:oracle:verify:local": "bun scripts/verify-duel-oracle-local.mjs",
    "duel:status": "bash scripts/check-streaming-status.sh",
    "runtime:check": "node scripts/node-runtime-policy.mjs",
    "runtime:check:test": "node --test scripts/node-runtime-policy.test.mjs",
    "eliza:runtime-pins": "node scripts/eliza-runtime-pin-policy.mjs",
    "eliza:runtime-pins:test": "node --test scripts/eliza-runtime-pin-policy.test.mjs",
    "eliza:runtime-smoke": "node scripts/eliza-runtime-import-smoke.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf test-*.json test-*.png *.log **/*.log test-results packages/docs-site/docs/api",
    "clean:all": "turbo run clean && rm -rf test-*.json test-*.png *.log **/*.log test-results packages/docs-site/docs/api node_modules/.cache .turbo packages/*/.turbo packages/*/tsconfig.tsbuildinfo",
    "app:dev": "cd packages/app && bun run dev",
    "app:build": "cd packages/app && bun run build",
    "app:build:debug": "cd packages/app && bun run build:debug",
    "app:ios:init": "cd packages/app && bun run ios:init",
    "app:ios:dev": "cd packages/app && bun run ios:dev",
    "app:ios:build": "cd packages/app && bun run ios:build",
    "app:android:init": "JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk NDK_HOME=$HOME/Library/Android/sdk/ndk/25.2.9519653 cd packages/app && bun run android:init",
    "app:android:dev": "JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk NDK_HOME=$HOME/Library/Android/sdk/ndk/25.2.9519653 cd packages/app && bun run android:dev",
    "app:android:build": "JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk NDK_HOME=$HOME/Library/Android/sdk/ndk/25.2.9519653 cd packages/app && bun run android:build",
    "app:icon": "cd packages/app && bun run icon",
    "docs:dev": "cd packages/docs-site && bun run start",
    "docs:generate": "typedoc",
    "docs:build": "bun run docs:generate && cd packages/docs-site && bun run build",
    "docs:serve": "cd packages/docs-site && bun run serve",
    "docs:clean": "rm -rf packages/docs-site/docs/api",
    "docs:rebuild": "bun run docs:clean && bun run docs:build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.9.1",
    "@docusaurus/preset-classic": "^3.9.2",
    "@eslint/js": "^9.0.0",
    "@gltf-transform/cli": "^4.1.1",
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "@livekit/rtc-node": "^0.13.24",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "22.20.1",
    "@types/three": "0.183.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.0.6",
    "bun-types": "^1.2.20",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "puppeteer": "^25.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rollup": "^4.52.4",
    "ts-jest": "^29.1.1",
    "turbo": "^2.5.5",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@types/node": "22.20.1",
    "@types/pg": "8.18.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@elizaos/core": "2.0.0-alpha.537",
    "@elizaos/plugin-anthropic": "2.0.0-alpha.537",
    "@elizaos/plugin-groq": "2.0.0-alpha.10",
    "@elizaos/plugin-openai": "2.0.0-alpha.537",
    "@elizaos/plugin-sql": "2.0.0-alpha.20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^6.0.2",
    "three": "0.183.2",
    "jsdom": "27.0.1",
    "@types/three": "0.183.1",
    "@pixiv/three-vrm": "3.4.3",
    "jws": "^3.2.3",
    "qs": ">=6.14.1",
    "h3": ">=1.15.5",
    "tar": ">=7.5.7",
    "elysia": ">=1.4.18",
    "hono": ">=4.11.4",
    "esbuild": ">=0.24.3",
    "@hpke/core": ">=1.7.5",
    "node-forge": ">=1.3.2",
    "lodash": ">=4.17.23",
    "lodash-es": ">=4.17.23",
    "vite": ">=8.0.0",
    "@trpc/server": ">=10.45.3 <11",
    "minimatch": ">=10.2.1",
    "cookie": "1.1.1",
    "undici": "7.24.3",
    "jsondiffpatch": ">=0.7.2",
    "tmp": ">=0.2.4",
    "diff": ">=8.0.3",
    "bn.js": ">=5.2.3",
    "ai": ">=5.0.52"
  },
  "packageManager": "bun@1.3.14",
  "lint-staged": {
    "*.{ts,tsx}": "prettier --write",
    "*.{js,jsx}": "prettier --write"
  },
  "dependencies": {
    "@elizaos/core": "2.0.0-alpha.537",
    "@elizaos/plugin-anthropic": "2.0.0-alpha.537",
    "@elizaos/plugin-groq": "2.0.0-alpha.10",
    "@elizaos/plugin-openai": "2.0.0-alpha.537",
    "@elizaos/plugin-sql": "2.0.0-alpha.20",
    "@livekit/rtc-node-linux-x64-gnu": "0.13.24",
    "@nomicfoundation/hardhat-ignition": "^3.0.7",
    "@rollup/rollup-darwin-x64": "^4.52.4",
    "@solana/web3.js": "^1.98.4",
    "@types/pg": "8.18.0",
    "@vitejs/plugin-react": "^6.0.1",
    "better-sqlite3": "^12.2.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "canvas": "^3.1.2",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.6",
    "meshoptimizer": "^0.22.0",
    "pg": "^8.16.3",
    "playwright": "^1.55.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.5",
    "ws": "^8.18.3"
  }
}
